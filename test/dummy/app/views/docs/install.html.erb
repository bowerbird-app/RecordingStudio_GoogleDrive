<% dummy_page_nav(title: "Install", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "Add Oauth, then point this gem at a workspace.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Add the gems",
    subtitle: "Google Drive plus Oauth. Pin the Oauth git tag.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      gem "recording_studio_google_drive"
      gem "recording_studio_oauth", github: "bowerbird-app/RecordingStudio_Oauth", tag: "v0.15.1"
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Install and migrate",
    subtitle: "Oauth stores the tokens. This gem does not.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_oauth:install
      bin/rails generate recording_studio_oauth:migrations
      bin/rails generate recording_studio_google_drive:install
      bin/rails db:migrate
    CODE
  ) %>
</div>
