<% dummy_page_nav(title: "Google Drive client", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Google Drive client",
    subtitle: "This dummy app boots Recording Studio so the Google Drive gem can load.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "What this host proves",
          subtitle: "Engine mount, dummy login, and Recording Studio layout.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>The Google Drive client is a library. Drive HTTP calls are covered in the gem suite.</li>
          <li>This app is the host that boots the engine with Recording Studio and FlatPack.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
