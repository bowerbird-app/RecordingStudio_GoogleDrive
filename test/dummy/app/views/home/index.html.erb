<% dummy_page_nav(title: "Google Drive", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Google Drive",
    subtitle: "Connect once. This dummy talks to a fake Drive, not Google.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(background: :shaded) do |card| %>
    <% card.header do %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: drive_status_title,
        subtitle: drive_status_subtitle,
        size: :md,
        spacing: :none
      ) %>
    <% end %>
    <% card.footer do %>
      <%= render FlatPack::Collection::Component.new(layout: :wrap, gap: :md) do |actions| %>
        <% if @drive_connection.nil? %>
          <% actions.with_item do %>
            <%= form_with url: recording_studio_oauth.outbound_connect_path(provider: drive_provider_key), method: :post do %>
              <%= hidden_field_tag :owner, "root" %>
              <%= hidden_field_tag :root_recording_id, @workspace_root.id if @workspace_root %>
              <%= hidden_field_tag :return_to, root_path %>
              <%= render FlatPack::Button::Component.new(text: "Connect Google Drive", style: :primary, size: :md, type: "submit") %>
            <% end %>
          <% end %>
        <% else %>
          <% if @drive_connection.needs_reconnect? || !@drive_ready %>
            <% actions.with_item do %>
              <%= form_with url: recording_studio_oauth.outbound_connect_path(provider: drive_provider_key), method: :post do %>
                <%= hidden_field_tag :owner, "root" %>
                <%= hidden_field_tag :root_recording_id, @workspace_root.id if @workspace_root %>
                <%= hidden_field_tag :return_to, root_path %>
                <%= render FlatPack::Button::Component.new(text: "Reconnect", style: :danger, size: :md, type: "submit") %>
              <% end %>
            <% end %>
          <% end %>
          <% actions.with_item do %>
            <%= form_with url: recording_studio_oauth.outbound_connection_path(@drive_connection), method: :delete do %>
              <%= hidden_field_tag :return_to, root_path %>
              <%= render FlatPack::Button::Component.new(text: "Disconnect", style: :secondary, size: :md, type: "submit") %>
            <% end %>
          <% end %>
        <% end %>
        <% if @upload_recording %>
          <% actions.with_item do %>
            <%= render FlatPack::Button::Component.new(
              text: "Upload to Getting Started",
              style: :secondary,
              size: :md,
              href: recording_studio_attachable.recording_attachment_upload_path(@upload_recording)
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
